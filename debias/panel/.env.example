# Copy this file to .env in the repository root and fill in the key.
# Never commit the filled-in .env — it is listed in .gitignore.

# Required. Read by llm_openai.py and step1_twin_build_master.py.
# Only the steps that CALL the API need it: step1 (question embeddings) and
# run_waves_simulations_original.py (LLM responses). step2 and step3 run from
# the committed artifacts with no key set.
OPENAI_API_KEY=sk-your-key-here

# Optional. Defaults shown are the values the code falls back to.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=150

# Optional. Only set this to point at an OpenAI-compatible proxy; unset means
# the default OpenAI endpoint.
# OPENAI_BASE_URL=
